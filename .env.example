# Core provider setup
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI-backed orchestrator/agent models
PLANNER_MODEL=gpt-4o
SPECIALIST_MODEL=gpt-4o
SYNTHESIS_MODEL=gpt-4o

# Claude/Anthropic models, active only when ANTHROPIC_API_KEY is set
CLAUDE_ARCHITECT_MODEL=claude-opus-4-5
CLAUDE_BLUEPRINT_MODEL=claude-opus-4-5

# Kimi - optional, enables Kimi K2.6 provider for kimi-* model names
# KIMI_API_KEY=your_kimi_api_key_here
# KIMI_MODEL=kimi-k2.6
# KIMI_THINKING=false

# OpenClaw gateway - optional, enables openclaw-* model names and tool gateway features
# OPENCLAW_GATEWAY_URL=http://localhost:18789
# OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token_here
# OPENCLAW_MODEL=openclaw-default

# GitHub - optional; active only when token/owner/repo exist and MCP flag is true
GITHUB_TOKEN=your_github_pat_here
GITHUB_OWNER=AndreRojasMB
GITHUB_REPO=ORQUESTADOR-PRIME
GITHUB_MCP_ENABLED=false

# n8n - optional outbound integration
# N8N_BASE_URL=http://localhost:5678
# N8N_API_KEY=your_n8n_api_key_here
# N8N_WEBHOOK_BASE_URL=http://localhost:5678

# WhatsApp/n8n/Twilio inbound hardening
# WHATSAPP_HOOK_TOKEN=your_whatsapp_hook_token_here
# WHATSAPP_N8N_SHARED_SECRET=your_n8n_shared_secret_here
# WHATSAPP_REQUIRE_STABLE_MESSAGE_ID=true
# WHATSAPP_VALIDATE_TWILIO_SIGNATURE=false
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_WEBHOOK_PUBLIC_URL=https://example.com/whatsapp-orchestrator

# Omi - optional, secret for webhook signature validation
# OMI_WEBHOOK_SECRET=your_omi_webhook_secret_here

# LightRAG - optional, active only when LIGHTRAG_API_KEY is set
# LIGHTRAG_BASE_URL=http://localhost:9621
# LIGHTRAG_API_KEY=your_lightrag_api_key_here

# Coolify - optional, active only when COOLIFY_API_TOKEN is set
# COOLIFY_API_URL=http://localhost:8000
# COOLIFY_API_TOKEN=your_coolify_api_token_here
# COOLIFY_PROJECT_UUID=your_coolify_project_uuid_here
# COOLIFY_SERVER_UUID=your_coolify_server_uuid_here

# Runtime/context controls
# CONTEXT_FORMAT=text
# LOG_LEVEL=info

# Real execution safety flags - keep disabled unless explicitly testing gated execution
# ACTIONS_REAL_EXECUTION_ENABLED=false
# SECOND_APPROVAL_TTL_MS=900000
# FILE_WRITE_ALLOWED_ROOTS=src,tests,docs,scripts
# FILE_WRITE_MAX_FILES=20
# FILE_WRITE_MAX_BYTES_PER_FILE=262144
# FILE_WRITE_MAX_TOTAL_BYTES=1048576
# FILE_WRITE_ALLOW_SENSITIVE=false
